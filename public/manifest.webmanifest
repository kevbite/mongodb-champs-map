{
  "name": "MongoDB Champions Map",
  "short_name": "Champions Map",
  "description": "An interactive Leaflet map of MongoDB Community Champions, rolled up by location.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
